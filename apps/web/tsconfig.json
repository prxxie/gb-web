{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "rootDir": "src",
    "lib": [
      "ES2023",
      "DOM",
      "DOM.Iterable"
    ],
    "jsx": "react-jsx",
    "types": [
      "vite/client"
    ],
    "resolveJsonModule": true,
    "paths": {
      "@gbw/core": [
        "../../packages/core/src/index.ts"
      ]
    },
    "outDir": "./dist-types",
    "tsBuildInfoFile": "./dist-types/tsconfig.tsbuildinfo"
  },
  "include": [
    "src/**/*.ts",
    "src/**/*.tsx",
    "src/**/*.json"
  ],
  "references": [
    {
      "path": "../../packages/core"
    }
  ]
}
