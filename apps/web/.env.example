# Copy to apps/web/.env.local for local work. Never commit a real value (rule 06).
#
# Both names are optional with a sane default, so a fresh checkout runs without this file:
# the SPA calls /api/v1 on its own origin and the dev server proxies it to the Worker.

# API base. Defaults to "/api/v1"; set a full origin only when the SPA and the Worker
# are served from different hosts and no proxy is in front of them.
VITE_API_BASE=/api/v1

# Clerk publishable key for the browser SDK. Absent means the sign-in button explains
# that accounts are not configured; the guest path keeps working.
VITE_CLERK_PUBLISHABLE_KEY=
