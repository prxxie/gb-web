{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "gbw-api",
  "main": "src/index.ts",
  "compatibility_date": "2026-10-01",
  "compatibility_flags": ["nodejs_compat"],
  "observability": { "enabled": true },
  // One cron: the 30-day purge of deleted accounts (`US-AUTH-004` AC4). 03:17 UTC keeps it clear of the
  // SLO snapshot job at 00:10, so a slow purge never delays the report.
  "triggers": { "crons": ["17 3 * * *"] },
  "vars": {
    "ENVIRONMENT": "development",
    "CLERK_ISSUER": "https://heroic-bison-1878.clerk.accounts.dev",
    "ALLOWED_ORIGINS": "http://localhost:5173"
  },
  "d1_databases": [
    {
      "binding": "GBW_DB",
      "database_name": "gbw",
      "database_id": "1a3895e6-6912-4960-afe6-5d3838e2dffd",
      "migrations_dir": "migrations"
    }
  ],
  "durable_objects": {
    "bindings": [{ "name": "ROOMS", "class_name": "Room" }]
  },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["Room"] }],
  "env": {
    "preview": {
      "name": "gbw-api-preview",
      "vars": {
        "ENVIRONMENT": "development",
        "CLERK_ISSUER": "https://heroic-bison-1878.clerk.accounts.dev",
        "ALLOWED_ORIGINS": "https://*.gbw-pages.pages.dev"
      },
      "d1_databases": [
        {
          "binding": "GBW_DB",
          "database_name": "gbw-preview",
          "database_id": "c969e339-ba75-4904-bafe-72292edba3ca",
          "migrations_dir": "migrations"
        }
      ],
      "durable_objects": { "bindings": [{ "name": "ROOMS", "class_name": "Room" }] },
      "migrations": [{ "tag": "v1", "new_sqlite_classes": ["Room"] }]
    },
    "production": {
      "name": "gbw-api",
      // No custom-domain route: this account has no zone, so the worker answers on its own
      // `gbw-api.gbw-demo.workers.dev` hostname. A domain would replace this block and the one in
      // `deploy-production.yml`'s health check (`vars.PRODUCTION_API_URL`).
      "workers_dev": true,
      "vars": {
        "ENVIRONMENT": "production",
        "CLERK_ISSUER": "https://heroic-bison-1878.clerk.accounts.dev",
        "ALLOWED_ORIGINS": "https://gbw-pages.pages.dev,http://localhost:5173,http://127.0.0.1:5173"
      },
      "d1_databases": [
        {
          "binding": "GBW_DB",
          "database_name": "gbw",
          "database_id": "1a3895e6-6912-4960-afe6-5d3838e2dffd",
          "migrations_dir": "migrations"
        }
      ],
      "durable_objects": { "bindings": [{ "name": "ROOMS", "class_name": "Room" }] },
      "migrations": [{ "tag": "v1", "new_sqlite_classes": ["Room"] }]
    }
  }
}
